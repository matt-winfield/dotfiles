#!/usr/bin/env bash
# Git credential helper for github.com/sg-ltd
# Resolves the Matthew-Winfield_sgltd GitHub CLI token through github-access-token,
# then $SUPERGROUP_GITHUB_TOKEN.

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case "$1" in
    get)
        # Consume the URL fields git sends on stdin
        while IFS= read -r line && [[ -n "$line" ]]; do
            :
        done

        if token="$("$script_dir/github-access-token" SUPERGROUP_GITHUB_TOKEN 2>/dev/null)"; then
            echo "username=x-access-token"
            echo "password=${token}"
        fi
        ;;
esac
