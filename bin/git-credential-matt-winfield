#!/usr/bin/env bash
# Git credential helper for github.com/matt-winfield
# Uses the personal gh account without changing the active account.

set -euo pipefail

personal_user="matt-winfield"

case "$1" in
    get)
        # Consume the URL fields git sends on stdin
        while IFS= read -r line && [[ -n "$line" ]]; do
            :
        done

        token="$(/opt/homebrew/bin/gh auth token --hostname github.com --user "$personal_user")"
        printf 'username=x-access-token\n'
        printf 'password=%s\n' "$token"
        ;;
esac
